# ==============================================================================
# CareWave EMR - Environment Configuration Template
# Copy this file to .env and replace with your actual environment values
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=aegis_his
# Local connection string (port 5434 on host for docker-compose):
DATABASE_URL="postgresql://aegis_user:your_secure_db_password@localhost:5434/aegis_his?schema=public"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="generate_a_random_64_character_secret_string"
JWT_EXPIRATION="1d"

# Server Ports
PORT=3000
BACKEND_PORT=4000
FRONTEND_PORT=3000

# MinIO / S3 Object Storage (for medical reports & attachments)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="aegis_minio_admin"
MINIO_SECRET_KEY="aegis_minio_secret_key"
MINIO_BUCKET_NAME="aegis-medical-records"
MINIO_USE_SSL="false"

# Frontend Public API URL
# For local development: http://localhost:3000
# For VPS production: https://yourdomain.com (or https://yourdomain.com/api/v1)
NEXT_PUBLIC_API_URL="http://localhost:3000"
